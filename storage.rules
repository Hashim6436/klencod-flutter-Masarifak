rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /appUpdates/android/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == "DZQBjkF778TGL9JoEQi1GSJ6jim1"
        && request.resource.size < 150 * 1024 * 1024
        && request.resource.contentType == 'application/vnd.android.package-archive';
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
