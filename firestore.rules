rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can access only their own financial data.
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public read-only OTA manifest; only the designated publisher can update it.
    match /appConfig/androidUpdate {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "DZQBjkF778TGL9JoEQi1GSJ6jim1";
    }

    // Deny everything else unless explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
